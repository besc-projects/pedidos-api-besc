<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <handlers>
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler"
                 resourceType="Unspecified" requireAccess="Script" />
        </handlers>

        <httpPlatform stdoutLogEnabled="true"
                      stdoutLogFile="C:\Users\cloud\pedidos-api-besc\app\logs\api.log"
                      startupTimeLimit="60"
                      requestTimeout="00:04:00"
                      forwardWindowsAuthToken="false"
                      processPath="C:\Users\cloud\pedidos-api-besc\app\.venv\Scripts\python.exe"
                      arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%">
            <environmentVariables>
                <environmentVariable name="PYTHONUNBUFFERED" value="1" />
                <environmentVariable name="PYTHONDONTWRITEBYTECODE" value="1" />
                <environmentVariable name="PYTHONUTF8" value="1" />
                <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
            </environmentVariables>
        </httpPlatform>

        <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

        <security>
            <authentication>
                <anonymousAuthentication enabled="true" />
                <windowsAuthentication enabled="false" />
            </authentication>
        </security>
    </system.webServer>
</configuration>
