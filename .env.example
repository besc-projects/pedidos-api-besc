# Copie para .env e preencha. NUNCA commite o .env real.

# Conexão do banco (async driver). Local:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/besc-orders-db
# Cloud SQL (via socket, dentro do Cloud Run):
# DATABASE_URL=postgresql+asyncpg://user:password@/besc-orders-db?host=/cloudsql/PROJECT:REGION:INSTANCE

# Segredo do JWT (nome sem ponto, compatível com Cloud Run)
JWT_SECRET=troque-por-um-segredo-forte

# Logs de SQL do SQLAlchemy (true/false)
ECHO_SQL=false

# Rodar create_all no startup (apenas dev; em prod o schema é do Alembic)
RUN_DB_CREATE_ALL=false
